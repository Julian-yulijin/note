<%
  var plain = strip_html(page.content).replace(/\s+/g, '');
  var minutes = Math.max(1, Math.ceil(plain.length / 350));

  // ---- 分类体系：支持任意层级 ----
  var allCategories = [];
  site.categories.each(function (c) { allCategories.push(c); });

  var catById = {};
  allCategories.forEach(function (c) { catById[String(c._id)] = c; });

  function categoryChain(c) {
    var chain = [];
    var cur = c;
    var guard = 0;
    while (cur && guard++ < 30) {
      chain.unshift(cur);
      cur = cur.parent ? catById[String(cur.parent)] : null;
    }
    return chain;
  }

  var catChildren = {};
  allCategories.forEach(function (c) {
    if (!c.parent) return;
    var key = String(c.parent);
    if (!catChildren[key]) catChildren[key] = [];
    catChildren[key].push(c);
  });

  var catRoots = allCategories.filter(function (c) { return !c.parent; });

  var currentCat = null;
  if (page.categories && page.categories.length) {
    page.categories.each(function (c) {
      if (!currentCat || categoryChain(c).length > categoryChain(currentCat).length) {
        currentCat = c;
      }
    });
  }

  var catPath = currentCat ? categoryChain(currentCat) : [];
  var activeCatIds = {};
  catPath.forEach(function (c) { activeCatIds[String(c._id)] = true; });
  var currentCatId = currentCat ? String(currentCat._id) : '';

  // 地图布局：先序遍历，按深度缩进，同一条根分支共用色相
  function flattenTree(nodes, depth, hue, out) {
    nodes.forEach(function (n) {
      var kids = catChildren[String(n._id)] || [];
      out.push({ node: n, depth: depth, hue: hue, kids: kids });
      if (kids.length) flattenTree(kids, depth + 1, hue, out);
    });
    return out;
  }

  var mapRowH = 26;
  var mapPadY = 10;
  var mapRows = [{
    node: { name: '知识库', path: '/categories/', _id: '__map_root' },
    depth: 0,
    hue: 0,
    kids: catRoots
  }];
  catRoots.forEach(function (root, idx) {
    flattenTree([root], 1, idx % 4, mapRows);
  });
  var mapHeight = mapRows.length * mapRowH + mapPadY * 2;
  activeCatIds['__map_root'] = catPath.length > 0;
  var mapIndex = {};
  mapRows.forEach(function (row, i) {
    row.y = mapPadY + i * mapRowH + mapRowH / 2;
    row.x = 12 + row.depth * 17;
    mapIndex[String(row.node._id)] = row;
  });

  var related = [];
  var tagNames = [];
  if (page.tags && page.tags.length) {
    page.tags.each(function (tag) { tagNames.push(tag.name); });
  }
  if (tagNames.length) {
    site.posts.each(function (p) {
      if (related.length >= 3 || p.path === page.path) return;
      var shared = 0;
      if (p.tags && p.tags.length) {
        p.tags.each(function (tag) {
          if (tagNames.indexOf(tag.name) !== -1) shared++;
        });
      }
      if (shared > 0) related.push(p);
    });
  }
%>
<article class="post">
  <header class="post-hero">
    <div class="wrap post-hero-inner">
      <p class="kicker">// NOTE</p>
      <h1 class="post-title"><%= page.title %></h1>
      <div class="post-meta">
        <time datetime="<%= page.date.toISOString() %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
        <span class="dot">·</span>
        <span><%= minutes %> 分钟阅读</span>
        <% if (catPath.length) { %>
        <span class="dot">·</span>
        <% catPath.forEach(function (category, i) { %>
          <% if (i) { %><span class="slash">/</span><% } %>
          <a href="<%- url_for(category.path) %>"><%= category.name %></a>
        <% }) %>
        <% } %>
      </div>
      <% if (page.tags && page.tags.length) { %>
      <div class="post-tags">
        <% page.tags.each(function (tag) { %>
        <a class="chip" href="<%- url_for(tag.path) %>"># <%= tag.name %></a>
        <% }) %>
      </div>
      <% } %>
    </div>
  </header>

  <div class="wrap post-body">
    <aside class="post-rail" aria-label="文章体系与操作">
      <div class="rail-actions">
        <button class="rail-btn" type="button" id="copy-link" aria-label="复制链接" title="复制链接">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
          </svg>
        </button>
        <button class="rail-btn" type="button" id="share-post" aria-label="分享" title="分享">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <path d="m8.6 10.6 6.8-4.2M8.6 13.4l6.8 4.2"></path>
          </svg>
        </button>
        <button class="rail-btn" type="button" id="back-top-rail" aria-label="回到顶部" title="回到顶部">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"></path>
          </svg>
        </button>
      </div>

      <div class="post-map">
        <p class="post-map-title">// 体系地图</p>
        <% if (catPath.length) { %>
        <p class="post-map-path">
          <% catPath.forEach(function (c, i) { %>
            <% if (i) { %><span class="map-sep">/</span><% } %><span><%= c.name %></span>
          <% }) %>
        </p>
        <svg class="map-svg" viewBox="0 0 192 <%= mapHeight %>" width="100%" height="<%= mapHeight %>" role="img" aria-label="文章分类体系地图">
          <g class="map-edges">
            <% mapRows.forEach(function (row) { %>
              <% row.kids.forEach(function (kid) { %>
                <% var child = mapIndex[String(kid._id)]; %>
                <% var onPath = activeCatIds[String(row.node._id)] && activeCatIds[String(kid._id)]; %>
                <path class="map-edge map-hue-<%= child.hue %><%= onPath ? ' is-path' : '' %>" d="M <%= row.x %> <%= row.y %> V <%= child.y - 8 %> Q <%= row.x %> <%= child.y %> <%= row.x + 8 %> <%= child.y %> H <%= child.x %>" fill="none"></path>
              <% }) %>
            <% }) %>
          </g>
          <g class="map-pins">
            <% mapRows.forEach(function (row) { %>
              <% var id = String(row.node._id); %>
              <% var isActive = !!activeCatIds[id]; %>
              <% var isCurrent = currentCatId === id; %>
              <a class="map-node-link map-hue-<%= row.hue %><%= isCurrent ? ' is-current' : '' %>" href="<%- url_for(row.node.path) %>">
                <% if (isCurrent) { %><circle class="map-halo" cx="<%= row.x %>" cy="<%= row.y %>" r="11"></circle><% } %>
                <circle class="map-pin<%= isCurrent ? ' is-current' : (isActive ? ' is-active' : '') %>" cx="<%= row.x %>" cy="<%= row.y %>" r="<%= isCurrent ? 5.2 : (isActive ? 3.8 : 3.4) %>"></circle>
                <text class="map-label<%= isCurrent ? ' is-current' : (isActive ? ' is-active' : '') %>" x="<%= row.x + 10 %>" y="<%= row.y + 3.6 %>"><%= row.node.name %></text>
                <% if (isCurrent) { %><text class="map-you" x="186" y="<%= row.y + 3.4 %>" text-anchor="end">本篇</text><% } %>
              </a>
            <% }) %>
          </g>
        </svg>
        <div class="map-legend">
          <span class="is-current"><i></i>本篇</span>
          <span class="is-path"><i></i>所属路径</span>
          <span><i></i>其他分支</span>
        </div>
        <% } else { %>
        <p class="post-map-empty">本篇尚未归入分类。在 front-matter 中用 <code>categories: [一级, 二级]</code> 即可建立多层体系。</p>
        <% } %>
        <a class="post-map-all" href="<%- url_for('/categories/') %>">查看全部分类 →</a>
      </div>
    </aside>

    <div class="post-main">
      <% if (!theme.toc || theme.toc.enable !== false) { %>
      <details class="toc-drawer">
        <summary>目录</summary>
        <nav class="toc-nav toc-nav-mobile" id="toc-nav-mobile" aria-label="文章目录"></nav>
      </details>
      <% } %>
      <div class="post-content" id="post-content"><%- page.content %></div>
    </div>

    <% if (!theme.toc || theme.toc.enable !== false) { %>
    <aside class="toc" id="toc" aria-label="文章目录">
      <p class="toc-title">目录</p>
      <nav class="toc-nav" id="toc-nav"></nav>
    </aside>
    <% } %>
  </div>

  <% if (page.prev || page.next) { %>
  <div class="wrap">
    <footer class="post-footer">
      <nav class="post-nav" aria-label="上一篇 / 下一篇">
        <% if (page.prev) { %>
        <a class="post-nav-link prev" href="<%- url_for(page.prev.path) %>">
          <span class="post-nav-label">← 上一篇</span>
          <span class="post-nav-title"><%= page.prev.title %></span>
        </a>
        <% } %>
        <% if (page.next) { %>
        <a class="post-nav-link next" href="<%- url_for(page.next.path) %>">
          <span class="post-nav-label">下一篇 →</span>
          <span class="post-nav-title"><%= page.next.title %></span>
        </a>
        <% } %>
      </nav>
    </footer>
  </div>
  <% } %>

  <% if (related.length) { %>
  <section class="wrap related">
    <div class="section-head">
      <h2 class="section-title">相关文章</h2>
      <span class="section-sub"><%= related.length %> 篇</span>
    </div>
    <div class="post-grid">
      <% related.forEach(function (post) { %>
        <%- partial('_partial/post-card', { post: post }) %>
      <% }) %>
    </div>
  </section>
  <% } %>
</article>
