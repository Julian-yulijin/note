<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('_partial/head') %>
<body data-root="<%- url_for('/') %>">
  <div class="page-glow" aria-hidden="true"></div>
  <%- partial('_partial/header') %>

  <main class="site-main" id="main">
    <%- body %>
  </main>

  <%- partial('_partial/footer') %>

  <div class="search-overlay" id="search-overlay" aria-hidden="true">
    <div class="search-panel" role="dialog" aria-modal="true" aria-label="全站搜索">
      <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="search-input" type="text" placeholder="搜索文章标题、内容、标签…" autocomplete="off" spellcheck="false">
        <button class="search-close" type="button" id="search-close">ESC</button>
      </div>
      <div class="search-results" id="search-results">
        <div class="search-empty">输入关键词开始搜索</div>
      </div>
      <div class="search-hint">↑ ↓ 选择 · Enter 打开 · Esc 关闭</div>
    </div>
  </div>

  <script src="<%- url_for('js/app.js') %>" defer></script>
</body>
</html>
