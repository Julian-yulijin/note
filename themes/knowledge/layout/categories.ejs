<%
  var roots = [];
  var childrenMap = {};
  site.categories.each(function (c) {
    if (!c.parent) roots.push(c);
    else {
      var key = String(c.parent);
      if (!childrenMap[key]) childrenMap[key] = [];
      childrenMap[key].push(c);
    }
  });
  var total = 0;
  site.categories.each(function () { total++; });
%>
<div class="wrap page-head">
  <p class="kicker">// CATEGORIES</p>
  <h1>分类</h1>
  <p class="page-desc">按主题归类的知识条目，共 <%= total %> 个分类、<%= roots.length %> 个一级分类。</p>
</div>

<section class="wrap section">
  <% if (roots.length) { %>
  <ul class="cat-tree">
    <% roots.forEach(function (root) { %>
    <%- partial('_partial/category-branch', { node: root, childrenMap: childrenMap }) %>
    <% }) %>
  </ul>
  <% } else { %>
  <div class="empty">还没有分类。在文章 front-matter 中添加 <code>categories</code> 即可自动归类。</div>
  <% } %>
</section>
