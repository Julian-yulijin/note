<%
  var nodeId = String(node._id);
  var kids = childrenMap[nodeId] || [];
  var isActive = !!activeIds[nodeId];
  var isCurrent = currentId === nodeId;
%>
<li class="map-node<%= isActive ? ' is-active' : '' %><%= isCurrent ? ' is-current' : '' %>" data-depth="<%= depth %>">
  <a class="map-link" href="<%- url_for(node.path) %>">
    <span class="map-dot" aria-hidden="true"></span>
    <span class="map-name"><%= node.name %></span>
    <% if (isCurrent) { %><span class="map-here">本篇</span><% } %>
  </a>
  <% if (kids.length) { %>
  <ul class="map-children">
    <% kids.forEach(function (child) { %>
      <%- partial('_partial/post-map-node', { node: child, childrenMap: childrenMap, activeIds: activeIds, currentId: currentId, depth: depth + 1 }) %>
    <% }) %>
  </ul>
  <% } %>
</li>
